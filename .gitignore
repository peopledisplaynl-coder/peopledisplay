# ============================================================
# PeopleDisplay .gitignore
# ============================================================

# Database Configuration (contains sensitive credentials)
/admin/db_config.php
/includes/db_config.php
/includes/config.php

# User Data
/uploads/
/uploads/**/*
/logs/
/logs/**/*
/backups/
/backups/**/*

# Runtime directories
/tmp/
/tmp/**/*

# Development / Tools
/tools/
/tools/**/*
tools/deploy_changes.*
tools/check_500.php

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
desktop.ini
.env
.env.local
.env.*.local

# Archive (if accidentally added)
*.zip
*.tar.gz
*.rar

# PHP Cache
*.php.cache

# System / Local
.claude/
*kopie*



# Node tooling (deploy script, checks) — never uploaded to the server
node_modules/

# Deploy script: FTP credentials and upload state stay on this computer only
deploy.config.json
.deploy-state/
update_files.txt

# Diagnostic scripts made during support sessions
Claude outputs/
